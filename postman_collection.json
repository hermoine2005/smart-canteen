{"info":{"name":"Smart Canteen API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
"variable":[{"key":"base","value":"http://localhost:5000/api"},{"key":"token","value":""}],
"item":[
{"name":"Register","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/auth/register","body":{"mode":"raw","raw":"{\"name\":\"Test User\",\"email\":\"test@x.com\",\"password\":\"secret1\"}"}}},
{"name":"Login (admin)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/auth/login?role=admin","body":{"mode":"raw","raw":"{\"email\":\"admin@canteen.com\",\"password\":\"admin123\"}"}}},
{"name":"GET foods","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base}}/foods"}},
{"name":"POST food","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/foods","body":{"mode":"raw","raw":"{\"name\":\"Pasta\",\"price\":80}"}}},
{"name":"PUT food","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/foods/FOOD_ID","body":{"mode":"raw","raw":"{\"price\":90}"}}},
{"name":"DELETE food","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base}}/foods/FOOD_ID"}},
{"name":"Place order (student)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/orders","body":{"mode":"raw","raw":"{\"items\":[{\"food\":\"FOOD_ID\",\"qty\":2}],\"pickupDate\":\"2026-11-02\",\"slot\":\"12:00 - 12:15\",\"payment\":\"counter\",\"coupon\":\"SAVE10\"}"}}},
{"name":"Update order status (admin)","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/orders/ORDER_ID/status","body":{"mode":"raw","raw":"{\"status\":\"ready\"}"}}},
{"name":"Verify QR (admin)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/orders/verify","body":{"mode":"raw","raw":"{\"token\":\"QR_CODE\"}"}}}]}
